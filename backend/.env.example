# Copie para .env para rodar com "npm run dev" fora do Docker.
DATABASE_URL=postgres://apis:apis@localhost:5432/apis
PORT=3000

# Máximo de registros por recurso para cada aluno.
LIMITE_REGISTROS=200

# Máximo de requisições por minuto por aluno (0 desativa).
LIMITE_REQ_MINUTO=300

# Horas até o token de login (parte 2) expirar.
TOKEN_HORAS=24

# Login da área /admin (cadastro de alunos). Sem ADMIN_SENHA, o /admin fica desligado.
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha
